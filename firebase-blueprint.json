{
  "entities": {
    "LayerPreset": {
      "title": "LayerPreset",
      "description": "2D artboard transform, fill color, and optional compressed artwork for front, back, or lanyard layer.",
      "type": "object",
      "properties": {
        "fitMode": {
          "type": "string",
          "enum": ["cover", "contain", "stretch"],
          "description": "How uploaded artwork fits the artboard bounds."
        },
        "scale": {
          "type": "number",
          "description": "Zoom multiplier between 0.5 and 2.5."
        },
        "offsetX": {
          "type": "number",
          "description": "Horizontal pan offset between -1 and 1."
        },
        "offsetY": {
          "type": "number",
          "description": "Vertical pan offset between -1 and 1."
        },
        "rotation": {
          "type": "number",
          "enum": [0, 90, 180, 270],
          "description": "Quarter-turn rotation in degrees."
        },
        "backgroundColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 9,
          "pattern": "^#[0-9a-fA-F]{3,8}$",
          "description": "Hex fill color for the layer base."
        },
        "lanyardRepeat": {
          "type": "number",
          "description": "Pattern repetition count along the 80cm strap (1 to 8)."
        },
        "uploadedFileName": {
          "type": "string",
          "maxLength": 120,
          "description": "Original filename of uploaded artwork, or empty string when using procedural template."
        },
        "artworkDataUrl": {
          "type": "string",
          "maxLength": 240000,
          "description": "Compressed data URL (WebP/JPEG/PNG) of uploaded artwork, or empty string for procedural template."
        }
      },
      "required": [
        "fitMode",
        "scale",
        "offsetX",
        "offsetY",
        "rotation",
        "backgroundColor",
        "lanyardRepeat",
        "uploadedFileName",
        "artworkDataUrl"
      ]
    },
    "StudioPresetConfig": {
      "title": "StudioPresetConfig",
      "description": "Complete 3D ID card, lanyard, protective case, material finish, and lighting configuration.",
      "type": "object",
      "properties": {
        "activeTemplate": {
          "type": "string",
          "enum": ["tech-vip", "corporate-sec", "minimal-staff"],
          "description": "Underlying procedural template style."
        },
        "cardFinish": {
          "type": "string",
          "enum": ["glossy", "matte"],
          "description": "PVC surface lamination finish."
        },
        "cardCaseEnabled": {
          "type": "boolean",
          "description": "Whether the rigid protective badge holder case is enabled."
        },
        "cardCaseStyle": {
          "type": "string",
          "enum": [
            "matte-obsidian",
            "frosted-clear",
            "glacier-white",
            "slate-aluminum",
            "cobalt-frame"
          ],
          "description": "Material style of the protective badge holder."
        },
        "edgePreset": {
          "type": "string",
          "enum": ["white", "black", "gold", "silver"],
          "description": "30-mil PVC core edge color."
        },
        "hardwareFinish": {
          "type": "string",
          "enum": ["brushed-steel", "matte-black", "champagne-gold"],
          "description": "Metallic finish for lobster clasp, swivel barrel, and crimp."
        },
        "hologramEnabled": {
          "type": "boolean",
          "description": "Whether the iridescent security foil overlay is enabled."
        },
        "hologramIntensity": {
          "type": "number",
          "description": "Hologram refraction strength between 0.2 and 1.0."
        },
        "studioBackdrop": {
          "type": "string",
          "enum": ["obsidian", "slate", "studio-light"],
          "description": "Studio environment backdrop color preset."
        },
        "showLanyard": {
          "type": "boolean",
          "description": "Whether the 80cm woven lanyard and metallic clasp are shown."
        },
        "front": {
          "type": "object",
          "$ref": "#/entities/LayerPreset",
          "description": "Front CR80 face configuration."
        },
        "back": {
          "type": "object",
          "$ref": "#/entities/LayerPreset",
          "description": "Back CR80 face configuration."
        },
        "lanyard": {
          "type": "object",
          "$ref": "#/entities/LayerPreset",
          "description": "80x2cm continuous lanyard strap configuration."
        }
      },
      "required": [
        "activeTemplate",
        "cardFinish",
        "cardCaseEnabled",
        "cardCaseStyle",
        "edgePreset",
        "hardwareFinish",
        "hologramEnabled",
        "hologramIntensity",
        "studioBackdrop",
        "showLanyard",
        "front",
        "back",
        "lanyard"
      ]
    },
    "CardPreset": {
      "title": "CardPreset",
      "description": "User-generated shareable 3D ID card and lanyard preset stored for cross-device loading and interaction.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display title for the ID card preset."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional short note describing the preset."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the preset creator."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Public display name of the creator (no email or PII)."
        },
        "isPublic": {
          "type": "boolean",
          "description": "When true, anyone with the share link or browsing the community gallery can load and interact with the 3D ID card."
        },
        "thumbnailDataUrl": {
          "type": "string",
          "maxLength": 45000,
          "description": "Compact front-card JPEG preview thumbnail data URL for the preset gallery."
        },
        "config": {
          "type": "object",
          "$ref": "#/entities/StudioPresetConfig",
          "description": "Complete 3D studio state snapshot."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-generated creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-generated last update timestamp."
        }
      },
      "required": [
        "title",
        "description",
        "ownerId",
        "authorName",
        "isPublic",
        "thumbnailDataUrl",
        "config",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/presets/{presetId}": {
      "schema": {
        "$ref": "#/entities/CardPreset"
      },
      "description": "User-generated 3D ID card & lanyard presets shareable across devices."
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped owner admin (zero DB lookups — safe for list rules)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'fathray29@gmail.com';
    }

    // Full admin check including Console-managed /admins/{uid} collection (single-doc operations only)
    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isNumeric(val) {
      return val is int || val is float;
    }

    function isValidHexColor(val) {
      return val is string && val.size() >= 4 && val.size() <= 9 && val.matches('^#[0-9a-fA-F]{3,8}$');
    }

    function isValidImageDataUrl(val, maxLen) {
      return val is string
        && val.size() <= maxLen
        && (
          val == ''
          || (val >= 'data:image/webp;base64,' && val < 'data:image/webp;base64-')
          || (val >= 'data:image/jpeg;base64,' && val < 'data:image/jpeg;base64-')
          || (val >= 'data:image/png;base64,' && val < 'data:image/png;base64-')
        );
    }

    function isValidArtworkUrl(val) {
      return isValidImageDataUrl(val, 240000);
    }

    function isValidThumbnailUrl(val) {
      return isValidImageDataUrl(val, 45000);
    }

    function isValidLayerPreset(layer) {
      return layer is map
        && layer.keys().hasAll([
          'fitMode',
          'scale',
          'offsetX',
          'offsetY',
          'rotation',
          'backgroundColor',
          'lanyardRepeat',
          'uploadedFileName',
          'artworkDataUrl'
        ])
        && layer.keys().hasOnly([
          'fitMode',
          'scale',
          'offsetX',
          'offsetY',
          'rotation',
          'backgroundColor',
          'lanyardRepeat',
          'uploadedFileName',
          'artworkDataUrl'
        ])
        && layer.fitMode is string
        && layer.fitMode in ['cover', 'contain', 'stretch']
        && isNumeric(layer.scale)
        && layer.scale >= 0.5
        && layer.scale <= 2.5
        && isNumeric(layer.offsetX)
        && layer.offsetX >= -1.0
        && layer.offsetX <= 1.0
        && isNumeric(layer.offsetY)
        && layer.offsetY >= -1.0
        && layer.offsetY <= 1.0
        && isNumeric(layer.rotation)
        && (layer.rotation == 0 || layer.rotation == 90 || layer.rotation == 180 || layer.rotation == 270)
        && isValidHexColor(layer.backgroundColor)
        && isNumeric(layer.lanyardRepeat)
        && layer.lanyardRepeat >= 1
        && layer.lanyardRepeat <= 8
        && layer.uploadedFileName is string
        && layer.uploadedFileName.size() <= 120
        && isValidArtworkUrl(layer.artworkDataUrl);
    }

    function isValidStudioConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll([
          'activeTemplate',
          'cardFinish',
          'cardCaseEnabled',
          'cardCaseStyle',
          'edgePreset',
          'hardwareFinish',
          'hologramEnabled',
          'hologramIntensity',
          'studioBackdrop',
          'showLanyard',
          'front',
          'back',
          'lanyard'
        ])
        && cfg.keys().hasOnly([
          'activeTemplate',
          'cardFinish',
          'cardCaseEnabled',
          'cardCaseStyle',
          'edgePreset',
          'hardwareFinish',
          'hologramEnabled',
          'hologramIntensity',
          'studioBackdrop',
          'showLanyard',
          'front',
          'back',
          'lanyard'
        ])
        && cfg.activeTemplate is string
        && cfg.activeTemplate in ['tech-vip', 'corporate-sec', 'minimal-staff']
        && cfg.cardFinish is string
        && cfg.cardFinish in ['glossy', 'matte']
        && cfg.cardCaseEnabled is bool
        && cfg.cardCaseStyle is string
        && cfg.cardCaseStyle in [
          'matte-obsidian',
          'frosted-clear',
          'glacier-white',
          'slate-aluminum',
          'cobalt-frame'
        ]
        && cfg.edgePreset is string
        && cfg.edgePreset in ['white', 'black', 'gold', 'silver']
        && cfg.hardwareFinish is string
        && cfg.hardwareFinish in ['brushed-steel', 'matte-black', 'champagne-gold']
        && cfg.hologramEnabled is bool
        && isNumeric(cfg.hologramIntensity)
        && cfg.hologramIntensity >= 0.2
        && cfg.hologramIntensity <= 1.0
        && cfg.studioBackdrop is string
        && cfg.studioBackdrop in ['obsidian', 'slate', 'studio-light']
        && cfg.showLanyard is bool
        && isValidLayerPreset(cfg.front)
        && isValidLayerPreset(cfg.back)
        && isValidLayerPreset(cfg.lanyard);
    }

    // Pillar 2: Standalone Validation Blueprint for CardPreset (Anti-Update-Gap)
    function isValidCardPreset(data) {
      return data is map
        && data.keys().hasAll([
          'title',
          'description',
          'ownerId',
          'authorName',
          'isPublic',
          'thumbnailDataUrl',
          'config',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'ownerId',
          'authorName',
          'isPublic',
          'thumbnailDataUrl',
          'config',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && data.description is string
        && data.description.size() <= 200
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 60
        && data.isPublic is bool
        && isValidThumbnailUrl(data.thumbnailDataUrl)
        && isValidStudioConfig(data.config)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Pillar 2: Standalone Validation Blueprint for UserQuota (no PII, strict counter bounds)
    function isValidUserQuota(data) {
      return data is map
        && data.keys().hasAll(['presetCount', 'lastPresetId', 'updatedAt'])
        && data.keys().hasOnly(['presetCount', 'lastPresetId', 'updatedAt'])
        && data.presetCount is int
        && data.presetCount >= 0
        && data.presetCount <= 100
        && isValidId(data.lastPresetId)
        && data.updatedAt is timestamp;
    }

    // Console-managed Admin Role Allowlist (zero client writes permitted)
    match /admins/{adminUid} {
      allow get: if isVerifiedUser()
        && isValidId(adminUid)
        && (request.auth.uid == adminUid || isBootstrappedAdmin());
      allow list, create, update, delete: if false;
    }

    // Atomic Per-User Preset Quota Counter (Pillar 7: Atomicity Guarantee)
    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && (request.auth.uid == userId || isAdmin());

      allow list: if false;

      // First preset creation initializes quota document at presetCount == 1 atomically with /presets/{lastPresetId}
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserQuota(incoming())
        && incoming().presetCount == 1
        && incoming().updatedAt == request.time
        && !exists(/databases/$(database)/documents/presets/$(incoming().lastPresetId))
        && existsAfter(/databases/$(database)/documents/presets/$(incoming().lastPresetId))
        && getAfter(/databases/$(database)/documents/presets/$(incoming().lastPresetId)).data.ownerId == userId;

      // Subsequent creates increment (+1 up to cap); deletes (by owner or admin takedown) decrement (-1)
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserQuota(incoming())
        && (request.auth.uid == userId || isAdmin())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['presetCount', 'lastPresetId', 'updatedAt'])
        && (
          // Action: Atomic +1 increment paired with creating a new preset owned by userId
          (
            request.auth.uid == userId
            && incoming().presetCount == existing().presetCount + 1
            && (incoming().presetCount <= 10 || (isAdmin() && incoming().presetCount <= 100))
            && !exists(/databases/$(database)/documents/presets/$(incoming().lastPresetId))
            && existsAfter(/databases/$(database)/documents/presets/$(incoming().lastPresetId))
            && getAfter(/databases/$(database)/documents/presets/$(incoming().lastPresetId)).data.ownerId == userId
          )
          ||
          // Action: Atomic -1 decrement paired with deleting an existing preset owned by userId
          (
            incoming().presetCount == existing().presetCount - 1
            && existing().presetCount >= 1
            && exists(/databases/$(database)/documents/presets/$(incoming().lastPresetId))
            && !existsAfter(/databases/$(database)/documents/presets/$(incoming().lastPresetId))
            && get(/databases/$(database)/documents/presets/$(incoming().lastPresetId)).data.ownerId == userId
          )
        );

      allow delete: if false;
    }

    // User-Generated Link-Only Shareable 3D ID Card Presets
    match /presets/{presetId} {
      // Link-only single-doc get: public presets accessible by direct link (?preset=<id>); private drafts owner/admin only
      allow get: if isValidId(presetId)
        && (
          resource == null
          || existing().isPublic == true
          || (isVerifiedUser() && (existing().ownerId == request.auth.uid || isAdmin()))
        );

      // Pillar 8: Anti-scraping list — NO public listing; owners list their own presets, bootstrapped admin lists for moderation
      allow list: if isVerifiedUser()
        && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      // Create: verified creator, strict schema, server timestamps, AND atomic quota counter increment (max 10 for standard users)
      allow create: if isVerifiedUser()
        && isValidId(presetId)
        && isValidCardPreset(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPresetId == presetId
        && (
          (
            !exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.presetCount == 1
          )
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.presetCount
              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.presetCount + 1
            && (
              getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.presetCount <= 10
              || (isAdmin() && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.presetCount <= 100)
            )
          )
        );

      // Update: validation blueprint first, immutable ownerId & createdAt, action-based affectedKeys allowlists
      allow update: if isVerifiedUser()
        && isValidId(presetId)
        && isValidCardPreset(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update preset design, title, description, visibility, or thumbnail
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'description',
            'isPublic',
            'thumbnailDataUrl',
            'config',
            'updatedAt'
          ])
          ||
          // Action: Toggle public/private visibility only
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isPublic',
            'updatedAt'
          ])
        );

      // Delete: verified owner OR admin takedown role
      allow delete: if isVerifiedUser()
        && isValidId(presetId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
